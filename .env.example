# ══════════════════════════════════════════════════════════════
# PERDINA Marketing Intelligence System — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy file ini ke .env dan isi dengan nilai yang sesuai.
# File .env TIDAK akan di-commit ke git (sudah ada di .gitignore).
#
# Untuk Vercel: set environment variables di Vercel Dashboard
#   → Project Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# URL project Supabase (https://xxx.supabase.co)
SUPABASE_URL=

# Anon key Supabase (publik, dilindungi RLS — bukan service key!)
SUPABASE_ANON_KEY=

# ── Accurate Online ──────────────────────────────────────────
# App Key dari Developer Portal
ACCURATE_APP_KEY=

# Signature Secret (JANGAN commit ke repo!)
ACCURATE_SIGNATURE_SECRET=

# Redirect URI untuk OAuth (harus cocok dengan yang terdaftar)
# Untuk GitHub Pages: https://perdinaindoutama.github.io/perdinamarketingerp/
ACCURATE_REDIRECT_URI=

# ── Vercel Proxy ─────────────────────────────────────────────
# URL Vercel function untuk CORS proxy ke Accurate Online API
# (otomatis ter-deploy, tidak perlu diisi manual)
# PROXY_URL=https://perdinamarketingerp.vercel.app/api/accurate-proxy
